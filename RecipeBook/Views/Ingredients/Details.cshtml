@*
    Ingredients/Details.cshtml — ADMIN: ONE INGREDIENT (read-only)
*@
@model RecipeBook.Models.Ingredient

@{
    ViewData["Title"] = "Детайли за съставка";
}

<section class="panel panel--narrow">
    <h1 class="panel__title">Детайли за съставка</h1>

    <dl class="detail-list">
        <dt>Име</dt>
        <dd>@Model.Name</dd>

        <dt>Категория</dt>
        <dd>@Model.IngredientCategory?.Name</dd>
    </dl>

    <div class="button-row">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Редактирай
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Назад към списъка
        </a>
    </div>
</section>
