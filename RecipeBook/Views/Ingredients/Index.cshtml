@*
    Ingredients/Index.cshtml — ADMIN: LIST OF INGREDIENTS
    -------------------------------------------------------------------------
    Page header with the "add" button, messages, a filter bar (name + category),
    the table and the pager.

    All admin list pages (Ingredients, IngredientCategories, RecipeCategories)
    share this structure and the .data-table look (components.css, section 9).
    The table sits in a .table-wrap so that on phones the table scrolls
    sideways instead of the whole page.
*@
@model PagedResult<RecipeBook.Models.Ingredient>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Съставки";
    var selectedCategoryId = ViewData[ViewDataKeys.SelectedCategoryId] as int?;
}

<div class="page-header">
    <h1>Съставки</h1>
    <a asp-action="Create" class="btn btn-accent">
        <i class="bi bi-plus-lg"></i> Добави нова съставка
    </a>
</div>

<partial name="_Alerts" />

@* A GET form without an action posts back to this page; the values end up in the address,
   which is how the pager keeps the filter when changing pages. *@
<form method="get" class="filter-bar">
    <div class="filter-bar__field">
        <label for="searchString" class="form-label">Име</label>
        <input id="searchString" type="search" name="searchString" class="form-control" placeholder="Търси по име..."
               value="@ViewData[ViewDataKeys.Search]" />
    </div>
    <div class="filter-bar__field">
        <label for="categoryId" class="form-label">Категория</label>
        <select id="categoryId" name="categoryId" class="form-select">
            <option value="">-- Всички категории --</option>
            @foreach (var cat in ViewData[ViewDataKeys.Categories] as SelectList ?? Enumerable.Empty<SelectListItem>())
            {
                <option value="@cat.Value" selected="@(selectedCategoryId == int.Parse(cat.Value))">
                    @cat.Text
                </option>
            }
        </select>
    </div>
    <div class="filter-bar__actions">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-funnel"></i> Филтрирай
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-x-lg"></i> Изчисти
        </a>
    </div>
</form>

<div class="table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th>Име</th>
                <th>Категория</th>
                <th class="data-table__actions">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.IngredientCategory?.Name</td>
                    <td class="data-table__actions">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icon" title="Редактирай">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-icon" title="Детайли">
                            <i class="bi bi-info-circle"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-icon btn-icon--danger" title="Изтрий">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="Model" />
