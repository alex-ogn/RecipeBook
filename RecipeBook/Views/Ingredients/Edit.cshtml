@*
    Ingredients/Edit.cshtml — ADMIN: EDIT AN INGREDIENT
    Same form as Create.cshtml, plus the hidden Id of the ingredient being edited.
*@
@model RecipeBook.Models.Ingredient
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Редакция на съставка";
}

<section class="panel panel--narrow">
    <h1 class="panel__title">Редактирай съставка</h1>

    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="form-errors"></div>
        <input type="hidden" asp-for="Id" />

        <div class="form-field">
            <label asp-for="Name" class="form-label">Име</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name"></span>
        </div>

        <div class="form-field">
            <label asp-for="IngredientCategoryId" class="form-label">Категория</label>
            <select asp-for="IngredientCategoryId" class="form-select" asp-items="@(ViewData[ViewDataKeys.IngredientCategories] as SelectList)"></select>
            <span asp-validation-for="IngredientCategoryId"></span>
        </div>

        <div class="button-row">
            <button type="submit" class="btn btn-primary">Запази</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
