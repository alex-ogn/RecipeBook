@*
    Ingredients/Delete.cshtml — ADMIN: CONFIRM DELETING AN INGREDIENT
    Nothing is deleted until the red button posts the form.
    If the ingredient is used by recipes, the controller refuses and shows a message on the list page.
*@
@model RecipeBook.Models.Ingredient

@{
    ViewData["Title"] = "Изтриване на съставка";
}

<section class="panel panel--narrow panel--danger">
    <h1 class="panel__title">Изтрий съставка</h1>

    <p>Сигурни ли сте, че искате да изтриете следната съставка?</p>

    <dl class="detail-list">
        <dt>Име</dt>
        <dd>@Model.Name</dd>

        <dt>Категория</dt>
        <dd>@Model.IngredientCategory?.Name</dd>
    </dl>

    <form asp-action="Delete" method="post" class="button-row">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash"></i> Изтрий
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
    </form>
</section>
