@*
    Home/Index.cshtml — THE HOME PAGE
    -------------------------------------------------------------------------
    1. Messages (e.g. "account deleted")           _Alerts partial
    2. Hero: welcome text, two buttons, two totals  .hero  (pages.css, section 1)
    3. "Препоръчани за теб" — only for signed-in users who have suggestions
    4. "Най-популярни" — the most popular recipes
    Recipe lists use the _RecipeCard partial inside a .recipe-grid.
*@
@using RecipeBook.ViewModels.Home;
@model HomeViewModel
@{
    ViewData["Title"] = "Начало";
}

<partial name="_Alerts" />

<section class="hero">
    <div class="hero__text">
        <h1 class="hero__title">Открийте радостта от готвенето</h1>
        <p class="hero__lead">Открийте нови рецепти, разгърнете креативността си и споделете кулинарните си шедьоври!</p>

        <div class="button-row">
            <a asp-controller="Recipes" asp-action="Create" class="btn btn-accent">
                <i class="bi bi-plus-lg"></i> Добави рецепта
            </a>
            <a asp-controller="Recipes" asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-compass"></i> Разгледай рецепти
            </a>
        </div>
    </div>

    @* The two totals on the right (under the text on phones). *@
    <div class="hero__stats">
        <div class="hero__stat">
            <span class="stat__number">@Model.CountRecipes</span>
            <span class="stat__label">Рецепти</span>
        </div>
        <div class="hero__stat">
            <span class="stat__number">@Model.CountUsers</span>
            <span class="stat__label">Потребители</span>
        </div>
    </div>
</section>

@if (Model.Suggestions?.Any() == true)
{
    <h2 class="section-title">Препоръчани за теб</h2>

    <div class="recipe-grid">
        @foreach (var recipe in Model.Suggestions)
        {
            <partial name="_RecipeCard" model="recipe" />
        }
    </div>
}

<h2 class="section-title">Най-популярни</h2>

<div class="recipe-grid">
    @foreach (var card in Model.FeaturedRecipes)
    {
        <partial name="_RecipeCard" model="card" />
    }
</div>
