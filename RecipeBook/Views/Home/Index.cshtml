@*
    Home/Index.cshtml — THE HOME PAGE
    -------------------------------------------------------------------------
    Sections, top to bottom (the styles are in wwwroot/css/pages.css, section 1):
      1. Messages (e.g. "account deleted")                    _Alerts partial
      2. Hero: welcome text, search box, buttons and totals    .hero
         over a slideshow of recipe photos in the background   .hero-slides
         (chosen by an admin on FeaturedRecipes/Index; by default the most liked recipes with a photo)
      3. Quick picks: "under 30 min" and diet links           .quick-picks
      4. "Препоръчани за теб" — signed-in users with suggestions
      5. "Как работи" — signed-out visitors only               .how-it-works
      6. Categories with recipe counts                        .category-tiles
      7. "Най-популярни" — the most popular recipes
      8. "Най-нови" — the newest recipes
      9. Join panel — signed-out visitors only                 .join-cta
    Recipe lists use the _RecipeCard partial inside a .recipe-grid.
    Every section after the hero is a <section class="home-section">: a header row
    (title + optional "see all" link) and its content.
    The slideshow is run by wwwroot/js/home-hero.js (loaded at the bottom of this file).
*@
@using RecipeBook.ViewModels.Enums;
@using RecipeBook.ViewModels.Home;
@model HomeViewModel
@{
    ViewData["Title"] = "Начало";
    var hasSlides = Model.HeroSlides.Any();
}

<partial name="_Alerts" />

@* ===================== 2. HERO ===================== *@
@* With photos, "hero--with-slides" turns the banner dark with white text (pages.css);
   without any (an empty site) it keeps the light look. *@
<section class="hero @(hasSlides ? "hero--with-slides" : "")">

    @* THE SLIDESHOW. All photos are stacked on top of each other behind the text; only the one with
       "is-active" is visible. home-hero.js moves "is-active" to the next photo every few seconds and
       CSS fades between them. Without JavaScript the first photo simply stays.
       data-interval = milliseconds per photo. The photos are decorative (alt=""): the caption link names the recipe. *@
    @if (hasSlides)
    {
        <div class="hero-slides" data-hero-slides data-interval="@FeaturedRecipeConstants.SlideIntervalMilliseconds">
            @for (var i = 0; i < Model.HeroSlides.Count; i++)
            {
                var slide = Model.HeroSlides[i];
                <img src="@slide.ImageUrl" alt="" class="hero-slides__image @(i == 0 ? "is-active" : "")"
                     data-slide-title="@slide.Title"
                     data-slide-url="@Url.Action("Details", "Recipes", new { id = slide.Id })"
                     loading="@(i == 0 ? "eager" : "lazy")" />
            }
        </div>
    }

    <div class="hero__text">
        <p class="hero__eyebrow"><i class="bi bi-fire"></i> Готвим заедно</p>
        <h1 class="hero__title">Открийте радостта от <span class="hero__highlight">готвенето</span></h1>
        <p class="hero__lead">Открийте нови рецепти, разгърнете креативността си и споделете кулинарните си шедьоври!</p>

        @* Same search as the top bar (Search/Index), just bigger and right where the eye lands. *@
        <form asp-controller="Search" asp-action="Index" method="get" class="hero-search" role="search">
            <i class="bi bi-search hero-search__icon" aria-hidden="true"></i>
            <input name="searchString" type="search" class="hero-search__input"
                   placeholder="Какво ще готвим днес?" aria-label="Търси рецепта" autocomplete="off" />
            <button type="submit" class="btn btn-primary hero-search__button">Търси</button>
        </form>

        <div class="button-row">
            <a asp-controller="Recipes" asp-action="Create" class="btn btn-accent">
                <i class="bi bi-plus-lg"></i> Добави рецепта
            </a>
            <a asp-controller="Recipes" asp-action="Index" class="btn btn-outline-primary hero__secondary-button">
                <i class="bi bi-compass"></i> Разгледай рецепти
            </a>
        </div>

        @* The two totals, as a quiet line under the buttons. *@
        <ul class="hero__stats">
            <li><strong>@Model.CountRecipes</strong> рецепти</li>
            <li><strong>@Model.CountUsers</strong> готвачи</li>
        </ul>
    </div>

    @* Bottom-right corner: which recipe is in the background (a link to it) and one dot per photo.
       home-hero.js updates the link and the dots when the photo changes; clicking a dot jumps to that photo.
       aria-live="polite": screen readers announce the new recipe name when it changes. *@
    @if (hasSlides)
    {
        var first = Model.HeroSlides[0];
        <div class="hero-slides__footer">
            <a class="hero-slides__caption" asp-controller="Recipes" asp-action="Details" asp-route-id="@first.Id"
               data-slide-caption aria-live="polite">
                <i class="bi bi-camera"></i> <span data-slide-caption-text>@first.Title</span>
            </a>

            @if (Model.HeroSlides.Count > 1)
            {
                <div class="hero-slides__dots">
                    @for (var i = 0; i < Model.HeroSlides.Count; i++)
                    {
                        <button type="button" class="hero-slides__dot @(i == 0 ? "is-active" : "")"
                                data-slide-dot="@i" aria-label="Снимка @(i + 1)"></button>
                    }
                </div>
            }
        </div>
    }
</section>

@* ===================== 3. QUICK PICKS ===================== *@
@* Each link opens the recipe list with one quick filter switched on
   (the names are the query-string keys that Recipes/Index reads). *@
<nav class="quick-picks" aria-label="Бърз избор">
    <a class="quick-pick" asp-controller="Recipes" asp-action="Index"
       asp-route-MaxCookingTime="@RecipeFilterConstants.QuickCookingMinutes">
        <i class="bi bi-stopwatch"></i> До @RecipeFilterConstants.QuickCookingMinutes мин
    </a>
    <a class="quick-pick" asp-controller="Recipes" asp-action="Index"
       asp-route-IsVegetarian="true">
        <i class="bi bi-flower1"></i> Вегетарианско
    </a>
    <a class="quick-pick" asp-controller="Recipes" asp-action="Index"
       asp-route-IsVegan="true">
        <i class="bi bi-tree"></i> Веганско
    </a>
    <a class="quick-pick" asp-controller="Recipes" asp-action="Index"
       asp-route-IsGlutenFree="true">
        <i class="bi bi-slash-circle"></i> Без глутен
    </a>
    <a class="quick-pick" asp-controller="Recipes" asp-action="Index"
       asp-route-IsLactoseFree="true">
        <i class="bi bi-droplet-half"></i> Без лактоза
    </a>
</nav>

@* ===================== 4. SUGGESTIONS ===================== *@
@if (Model.Suggestions.Any())
{
    <section class="home-section">
        <div class="home-section__header">
            <h2 class="section-title">Препоръчани за теб</h2>
        </div>

        <div class="recipe-grid">
            @foreach (var recipe in Model.Suggestions)
            {
                <partial name="_RecipeCard" model="recipe" />
            }
        </div>
    </section>
}

@* ===================== 5. HOW IT WORKS (signed-out only) ===================== *@
@if (!Model.IsSignedIn)
{
    <section class="home-section how-it-works">
        <div class="home-section__header">
            <h2 class="section-title">Как работи</h2>
        </div>

        <ol class="how-it-works__steps">
            <li class="how-it-works__step">
                <i class="bi bi-search-heart"></i>
                <h3>Открий</h3>
                <p>Разгледай рецепти по категория, време за готвене или диета.</p>
            </li>
            <li class="how-it-works__step">
                <i class="bi bi-egg-fried"></i>
                <h3>Сготви</h3>
                <p>Запази любимите си и ги изтегли като PDF за кухнята.</p>
            </li>
            <li class="how-it-works__step">
                <i class="bi bi-people"></i>
                <h3>Сподели</h3>
                <p>Публикувай свои рецепти, следвай готвачи и коментирай.</p>
            </li>
        </ol>
    </section>
}

@* ===================== 6. CATEGORIES ===================== *@
@if (Model.Categories.Any())
{
    <section class="home-section">
        <div class="home-section__header">
            <h2 class="section-title">Категории</h2>
            <a class="home-section__more" asp-controller="Recipes" asp-action="Index">Всички рецепти <i class="bi bi-arrow-right"></i></a>
        </div>

        @* One row only. When the tiles don't fit, the row scrolls sideways: swipe on phones,
           the arrow buttons on wider screens (the .scroller helper: components.css section 17 + site.js).
           The arrows start "hidden"; site.js shows each one only when there is more to see that way. *@
        <div class="scroller" data-scroller>
            <button type="button" class="scroller__button scroller__button--prev" data-scroller-prev hidden aria-label="Предишни категории">
                <i class="bi bi-chevron-left"></i>
            </button>

            <div class="category-tiles" data-scroller-track>
                @foreach (var category in Model.Categories)
                {
                    @* A photo card: the photo of the category's most liked recipe fills the tile, and the
                       name sits in white on a dark fade at the bottom. A category without any photo gets
                       a plain colored tile with an icon instead ("category-tile--no-photo"). *@
                    <a class="category-tile @(category.ImageUrl == null ? "category-tile--no-photo" : "")"
                       asp-controller="Recipes" asp-action="Index" asp-route-SelectedCategoryId="@category.Id">
                        @if (category.ImageUrl != null)
                        {
                            <img src="@category.ImageUrl" alt="" class="category-tile__image" loading="lazy" />
                        }
                        else
                        {
                            <i class="bi bi-egg-fried category-tile__icon" aria-hidden="true"></i>
                        }
                        <span class="category-tile__text">
                            <span class="category-tile__name">@category.Name</span>
                            <span class="category-tile__count">@category.RecipeCount рецепти</span>
                        </span>
                    </a>
                }
            </div>

            <button type="button" class="scroller__button scroller__button--next" data-scroller-next hidden aria-label="Следващи категории">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </section>
}

@* ===================== 7. MOST POPULAR ===================== *@
@if (Model.PopularRecipes.Any())
{
    <section class="home-section">
        <div class="home-section__header">
            <h2 class="section-title">Най-популярни</h2>
            <a class="home-section__more" asp-controller="Recipes" asp-action="Index"
               asp-route-sortOrder="@RecipeSortOption.MostLiked">Виж всички <i class="bi bi-arrow-right"></i></a>
        </div>

        <div class="recipe-grid">
            @foreach (var card in Model.PopularRecipes)
            {
                <partial name="_RecipeCard" model="card" />
            }
        </div>
    </section>
}

@* ===================== 8. NEWEST ===================== *@
@if (Model.NewestRecipes.Any())
{
    <section class="home-section">
        <div class="home-section__header">
            <h2 class="section-title">Най-нови</h2>
            <a class="home-section__more" asp-controller="Recipes" asp-action="Index">Виж всички <i class="bi bi-arrow-right"></i></a>
        </div>

        <div class="recipe-grid">
            @foreach (var card in Model.NewestRecipes)
            {
                <partial name="_RecipeCard" model="card" />
            }
        </div>
    </section>
}

@* ===================== 9. JOIN PANEL (signed-out only) ===================== *@
@if (!Model.IsSignedIn)
{
    <section class="home-section">
        <div class="join-cta">
            <div>
                <h2 class="join-cta__title">Присъедини се към общността</h2>
                <p class="join-cta__text">Регистрацията е безплатна и отнема минута.</p>
            </div>
            <a asp-controller="Account" asp-action="Register" class="btn btn-accent join-cta__button">
                <i class="bi bi-person-plus"></i> Регистрация
            </a>
        </div>
    </section>
}

@section Scripts {
    @if (hasSlides)
    {
        <script src="~/js/home-hero.js" asp-append-version="true"></script>
    }
}
