@*
    IngredientCategories/Edit.cshtml — ADMIN: EDIT AN INGREDIENT CATEGORY
*@
@model RecipeBook.Models.IngredientCategory

@{
    ViewData["Title"] = "Редакция на категория";
}

<section class="panel panel--narrow">
    <h1 class="panel__title">Редактирай категория</h1>

    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="form-errors"></div>
        <input type="hidden" asp-for="Id" />

        <div class="form-field">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name"></span>
        </div>

        <div class="button-row">
            <button type="submit" class="btn btn-primary">Запази</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
