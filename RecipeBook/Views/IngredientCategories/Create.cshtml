@*
    IngredientCategories/Create.cshtml — ADMIN: ADD AN INGREDIENT CATEGORY
*@
@model RecipeBook.Models.IngredientCategory

@{
    ViewData["Title"] = "Създаване на категория";
}

<section class="panel panel--narrow">
    <h1 class="panel__title">Създай нова категория</h1>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="form-errors"></div>

        <div class="form-field">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name"></span>
        </div>

        <div class="button-row">
            <button type="submit" class="btn btn-primary">Създай</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
