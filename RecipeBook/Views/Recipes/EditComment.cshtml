@*
    Recipes/EditComment.cshtml — EDIT ONE COMMENT
    -------------------------------------------------------------------------
    Opened from the pencil icon next to a comment on the recipe page.
    "Отказ" goes back to that recipe (Model.RecipeId).
*@
@using RecipeBook.ViewModels.Recipes;
@model CommentEditViewModel
@{
    ViewData["Title"] = "Редактирай коментар";
}

<section class="panel panel--narrow">
    <h1 class="panel__title">Редактирай коментар</h1>

    <form asp-action="EditComment" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="form-field">
            <label asp-for="Content" class="form-label"></label>
            <textarea asp-for="Content" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Content"></span>
        </div>

        <div class="button-row">
            <button type="submit" class="btn btn-primary">Запази промените</button>
            <a asp-action="Details" asp-route-id="@Model.RecipeId" class="btn btn-outline-secondary">Отказ</a>
        </div>
    </form>
</section>
