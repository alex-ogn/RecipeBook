@*
    Recipes/Edit.cshtml — EDIT A RECIPE
    -------------------------------------------------------------------------
    Same fields as Create.cshtml (the _RecipeFormFields partial), plus the
    hidden Id of the recipe being edited.
    enctype="multipart/form-data" is required for the photo upload to work.
*@
@using RecipeBook.ViewModels.Recipes;
@model RecipeEditViewModel
@{
    ViewData["Title"] = "Редакция на рецепта";
}

<div class="page-header">
    <h1>Редакция на рецепта</h1>
</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="recipe-form">
    <input type="hidden" asp-for="Id" />

    <partial name="_RecipeFormFields" model="Model" />

    <div class="button-row">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg"></i> Запази
        </button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Назад</a>
    </div>
</form>

@* Styles and scripts needed only on this page; _Layout.cshtml puts them in <head> / at the end of <body>. *@
@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/trumbowyg@2.28.0/dist/ui/trumbowyg.min.css" />
}

@section Scripts {
    @* Trumbowyg = the rich-text editor. It needs jQuery, which _Layout.cshtml already loaded. *@
    <script src="https://cdn.jsdelivr.net/npm/trumbowyg@2.28.0/dist/trumbowyg.min.js"></script>
    <script src="~/js/recipe-form.js" asp-append-version="true"></script>
}
