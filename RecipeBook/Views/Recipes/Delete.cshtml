@*
    Recipes/Delete.cshtml — CONFIRM DELETING A RECIPE
    -------------------------------------------------------------------------
    A confirmation page: nothing is deleted until the red button is pressed
    (it posts the form to the Delete action).
*@
@model RecipeBook.Models.Recipe

@{
    ViewData["Title"] = "Изтриване";
}

<section class="panel panel--narrow panel--danger">
    <h1 class="panel__title">Изтриване на рецепта</h1>

    <p>Сигурни ли сте, че искате да изтриете тази рецепта? Действието не може да бъде отменено.</p>

    <dl class="detail-list">
        <dt>Име</dt>
        <dd>@Model.Title</dd>
    </dl>

    <form asp-action="Delete" method="post" class="button-row">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash"></i> Изтрий
        </button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Назад</a>
    </form>
</section>
