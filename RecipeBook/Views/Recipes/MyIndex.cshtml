@*
    Recipes/MyIndex.cshtml — A USER'S PROFILE PAGE
    -------------------------------------------------------------------------
    Shows any user (not only "me"): the address is /Recipes/MyIndex/{user id}.

    1. Profile header: avatar, name, counters (recipes / followers / following)
       and one button:
         - on your own profile:      "Нова рецепта" and "Настройки"
         - on someone else's:        "Последвай" / "Отследвай" (a POST form)
    2. That user's recipes (_RecipeCard in a .recipe-grid) and the pager.

    The look of the header is in wwwroot/css/pages.css, section 2.
*@
@using RecipeBook.ViewModels.Recipes;
@model UserRecipesViewModel

@{
    var user = Model.User;
    var isFollowing = Model.IsFollowing;
    ViewData["Title"] = user.UserName;
}

<partial name="_Alerts" />

<section class="profile-header">
    <img src="@Url.Action("GetProfilePicture", "Users", new { userId = user.Id, pictureVersion = user.ProfilePictureVersion })"
         alt="Профилна снимка" class="avatar avatar--lg" />

    <div class="profile-header__info">
        <h1 class="profile-header__name">@user.UserName</h1>

        @* Counters. Followers / following are links to the lists of people. *@
        <div class="profile-header__stats">
            <span class="stat">
                <span class="stat__number">@Model.Recipes.TotalCount</span>
                <span class="stat__label">Рецепти</span>
            </span>
            <a class="stat" asp-controller="Users" asp-action="Followers" asp-route-id="@user.Id">
                <span class="stat__number">@Model.FollowersCount</span>
                <span class="stat__label">Последователи</span>
            </a>
            <a class="stat" asp-controller="Users" asp-action="Following" asp-route-id="@user.Id">
                <span class="stat__number">@Model.FollowingCount</span>
                <span class="stat__label">Следвани</span>
            </a>
        </div>

        <div class="button-row">
            @if (Model.IsOwnProfile)
            {
                <a asp-controller="Recipes" asp-action="Create" class="btn btn-sm btn-accent">
                    <i class="bi bi-plus-lg"></i> Нова рецепта
                </a>
                <a asp-controller="Users" asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-gear"></i> Настройки
                </a>
            }
            else
            {
                @* Follow / unfollow changes data, so it is a POST form. The same form
                   posts to "Follow" or "Unfollow" depending on the current state. *@
                <form asp-controller="Users" asp-action="@(isFollowing ? "Unfollow" : "Follow")" method="post">
                    <input type="hidden" name="userId" value="@user.Id" />
                    <button type="submit" class="btn btn-sm @(isFollowing ? "btn-outline-primary" : "btn-primary")">
                        <i class="bi @(isFollowing ? "bi-person-check" : "bi-person-plus")"></i>
                        @(isFollowing ? "Отследвай" : "Последвай")
                    </button>
                </form>
            }
        </div>
    </div>
</section>

<h2 class="section-title">Рецепти на @user.UserName</h2>

@if (Model.Recipes.Any())
{
    <div class="recipe-grid">
        @foreach (var card in Model.Recipes)
        {
            <partial name="_RecipeCard" model="card" />
        }
    </div>

    <partial name="_Pager" model="Model.Recipes" />
}
else
{
    <div class="empty-state">
        <i class="bi bi-journal-plus"></i>
        Все още няма публикувани рецепти.
    </div>
}
