@using RecipeBook.ViewModels.Enums;
@using RecipeBook.ViewModels.Recipes;

@model RecipeFilterViewModel

@{
    // Also rendered for search results (SearchController), so links always target RecipesController.
    // The filter applies to the list being shown (all, liked, saved, followed); search results filter the main list.
    var isRecipesController = string.Equals(ViewContext.RouteData.Values["controller"] as string, "Recipes", StringComparison.OrdinalIgnoreCase);
    var listAction = isRecipesController ? ViewContext.RouteData.Values["action"] as string : "Index";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap">
        <h1 class="display-5 mb-2">Рецепти</h1>
        <a asp-controller="Recipes" asp-action="Create" class="btn btn-success">+ Нова рецепта</a>
    </div>

    @if (TempData[TempDataKeys.SearchResults] != null)
{
    <div class="alert alert-info mt-3">
        Резултати от търсене за: <strong>@TempData[TempDataKeys.SearchResults]</strong>
    </div>
}
    @if (TempData[TempDataKeys.ErrorMessage] != null)
    {
        <div class="alert alert-danger">@TempData[TempDataKeys.ErrorMessage]</div>
    }

    @if (TempData[TempDataKeys.SuccessMessage] != null)
    {
        <div class="alert alert-success">@TempData[TempDataKeys.SuccessMessage]</div>
    }

    <form asp-controller="Recipes" asp-action="@listAction" method="get" class="mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Категория:</label>
                <select asp-for="SelectedCategoryId" asp-items="Model.Categories" class="form-select">
                    <option value="">Всички</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Сортирай по:</label>
                <select name="sortOrder" class="form-select">
                    @foreach (RecipeSortOption option in Enum.GetValues(typeof(RecipeSortOption)))
                    {
                        var label = option switch
                        {
                            RecipeSortOption.Newest => "Най-нови",
                            RecipeSortOption.MostLiked => "Най-харесвани",
                            RecipeSortOption.MostViewed => "Най-гледани",
                            _ => option.ToString()
                        };

                        <option value="@option" selected="@(Model.SortOrder == option)">
                            @label
                        </option>
                    }
                </select>
            </div>
    <div class="col-md-4 d-flex gap-2">

        <button type="submit" class="btn btn-outline-accent me-2">
            <i class="bi bi-funnel"></i> Филтрирай
        </button>

        <a asp-controller="Recipes" asp-action="@listAction" class="btn btn-outline-warning btn-unstyled">
            <i class="bi bi-x-circle"></i> Изчисти
        </a>

    </div>
        </div>
    </form>

    @if (Model.Recipes.Any())
    {
        <div class="row">
            @foreach (var card in Model.Recipes)
            {
                <partial name="_RecipeCard" model="card" />
            }
        </div>

        <partial name="_Pager" model="Model.Recipes" />
    }
    else
    {
        <div class="alert alert-info mt-4">Няма рецепти по избрания филтър.</div>
    }
</div>


