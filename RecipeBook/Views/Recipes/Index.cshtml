@*
    Recipes/Index.cshtml — A LIST OF RECIPES WITH FILTERS
    -------------------------------------------------------------------------
    One view, used by five pages:
      Recipes/Index                 all recipes
      Recipes/LikedRecipes          recipes the user liked
      Recipes/SavedRecipes          recipes the user saved
      Recipes/FollowedUsersRecipes  recipes from people the user follows
      Search/Index                  search results

    Parts: page header, messages, filter bar (category + sort order),
    the cards (_RecipeCard in a .recipe-grid) and the page numbers (_Pager).
*@
@using RecipeBook.ViewModels.Enums;
@using RecipeBook.ViewModels.Recipes;
@model RecipeFilterViewModel

@{
    // Also rendered for search results (SearchController), so links always target RecipesController.
    // The filter applies to the list being shown (all, liked, saved, followed); search results filter the main list.
    var isRecipesController = string.Equals(ViewContext.RouteData.Values["controller"] as string, "Recipes", StringComparison.OrdinalIgnoreCase);
    var listAction = isRecipesController ? ViewContext.RouteData.Values["action"] as string : "Index";

    // The heading depends on which of the lists is shown.
    var heading = listAction switch
    {
        "LikedRecipes" => "Харесани рецепти",
        "SavedRecipes" => "Запазени рецепти",
        "FollowedUsersRecipes" => "Рецепти от следвани",
        _ => "Рецепти"
    };
    ViewData["Title"] = heading;
}

<div class="page-header">
    <h1>@heading</h1>
    <a asp-controller="Recipes" asp-action="Create" class="btn btn-accent">
        <i class="bi bi-plus-lg"></i> Нова рецепта
    </a>
</div>

<partial name="_Alerts" />

@* The filter is a GET form: the chosen values go into the address
   (?SelectedCategoryId=3&sortOrder=MostLiked), so the result can be bookmarked
   and the pager can keep them when changing pages. *@
<form asp-controller="Recipes" asp-action="@listAction" method="get" class="filter-bar">
    @* Quick filters chosen on the home page (time, diet). They have no field of their own, so they
       travel as hidden inputs: changing the category or the sort order keeps them.
       "Изчисти" below removes them together with everything else. *@
    @if (Model.MaxCookingTime.HasValue)
    {
        <input type="hidden" name="@nameof(Model.MaxCookingTime)" value="@Model.MaxCookingTime" />
    }
    @if (Model.IsVegetarian)
    {
        <input type="hidden" name="@nameof(Model.IsVegetarian)" value="true" />
    }
    @if (Model.IsVegan)
    {
        <input type="hidden" name="@nameof(Model.IsVegan)" value="true" />
    }
    @if (Model.IsGlutenFree)
    {
        <input type="hidden" name="@nameof(Model.IsGlutenFree)" value="true" />
    }
    @if (Model.IsLactoseFree)
    {
        <input type="hidden" name="@nameof(Model.IsLactoseFree)" value="true" />
    }

    <div class="filter-bar__field">
        <label asp-for="SelectedCategoryId" class="form-label">Категория</label>
        <select asp-for="SelectedCategoryId" asp-items="Model.Categories" class="form-select">
            <option value="">Всички</option>
        </select>
    </div>

    <div class="filter-bar__field">
        <label for="sortOrder" class="form-label">Сортирай по</label>
        <select id="sortOrder" name="sortOrder" class="form-select">
            @foreach (RecipeSortOption option in Enum.GetValues(typeof(RecipeSortOption)))
            {
                var label = option switch
                {
                    RecipeSortOption.Newest => "Най-нови",
                    RecipeSortOption.MostLiked => "Най-харесвани",
                    RecipeSortOption.MostViewed => "Най-гледани",
                    _ => option.ToString()
                };

                <option value="@option" selected="@(Model.SortOrder == option)">@label</option>
            }
        </select>
    </div>

    <div class="filter-bar__actions">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-funnel"></i> Филтрирай
        </button>
        <a asp-controller="Recipes" asp-action="@listAction" class="btn btn-outline-secondary">
            <i class="bi bi-x-lg"></i> Изчисти
        </a>
    </div>
</form>

@* Shows which quick filters are on, so the list doesn't look mysteriously short. *@
@if (Model.HasQuickFilter)
{
    <div class="chip-list active-filters" aria-label="Активни филтри">
        @if (Model.MaxCookingTime.HasValue)
        {
            <span class="chip chip--orange"><i class="bi bi-stopwatch"></i> До @Model.MaxCookingTime мин</span>
        }
        @if (Model.IsVegetarian)
        {
            <span class="chip chip--green"><i class="bi bi-flower1"></i> Вегетарианско</span>
        }
        @if (Model.IsVegan)
        {
            <span class="chip chip--green"><i class="bi bi-tree"></i> Веганско</span>
        }
        @if (Model.IsGlutenFree)
        {
            <span class="chip chip--green"><i class="bi bi-slash-circle"></i> Без глутен</span>
        }
        @if (Model.IsLactoseFree)
        {
            <span class="chip chip--green"><i class="bi bi-droplet-half"></i> Без лактоза</span>
        }
    </div>
}

@if (Model.Recipes.Any())
{
    <div class="recipe-grid">
        @foreach (var card in Model.Recipes)
        {
            <partial name="_RecipeCard" model="card" />
        }
    </div>

    <partial name="_Pager" model="Model.Recipes" />
}
else
{
    <div class="empty-state">
        <i class="bi bi-egg-fried"></i>
        Няма рецепти по избрания филтър.
    </div>
}
