@*
    _LoginPartial.cshtml — RIGHT SIDE OF THE TOP BAR
    -------------------------------------------------------------------------
    Signed in:      the user's avatar (the "ProfileImage" view component,
                    Views/Shared/Components/ProfileImage/Default.cshtml).
    Not signed in:  "Вход" and "Регистрация" buttons. They are hidden on small
                    screens ("d-none d-md-inline-flex" = show from 768px up),
                    where the bottom tab bar already has the same two links.
*@
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    @await Component.InvokeAsync("ProfileImage")
}
else
{
    <a class="btn btn-sm btn-outline-secondary d-none d-md-inline-flex" asp-controller="Account" asp-action="Login">Вход</a>
    <a class="btn btn-sm btn-primary d-none d-md-inline-flex" asp-controller="Account" asp-action="Register">Регистрация</a>
}
