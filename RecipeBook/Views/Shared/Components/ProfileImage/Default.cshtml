@*
    ProfileImage view component — the signed-in user's avatar in the top bar.
    Clicking it opens the profile settings (Users/Edit).

    The picture is a plain file under /images/profiles/ (or the default avatar).
    Every upload gets a new file name, so the browser never shows an old picture
    from its cache.
*@
@using RecipeBook.ViewModels.Users;
@model ProfileImageViewModel

@if (Model != null)
{
    <a asp-controller="Users" asp-action="Edit" asp-route-id="@Model.UserId" title="Настройки на профила">
        <img src="@Model.ProfilePictureUrl"
             alt="Профил" class="avatar avatar--sm" />
    </a>
}
