@*
    Account/ChangeEmailSent.cshtml — MESSAGE: "check your new mailbox"
    Rendered inside the centered card of _AuthLayout.cshtml.
*@
@{
    ViewData["Title"] = "Провери новата си поща";
    Layout = "_AuthLayout";
}

<div class="auth__icon"><i class="bi bi-envelope-check"></i></div>
<h1 class="auth__title">Провери новата си поща</h1>
<p class="auth__lead">Ако адресът е свободен, изпратихме линк за потвърждение на новия имейл. Имейлът на профила ще се смени, след като отвориш линка.</p>

<a asp-controller="Users" asp-action="Edit" class="btn btn-primary w-100">Обратно към профила</a>
