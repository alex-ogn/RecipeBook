@{
    ViewData["Title"] = "Провери новата си поща";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow" style="max-width: 500px; width: 100%;">
        <div class="card-body p-4 text-center">
            <div class="mb-3">
                <i class="bi bi-envelope-check text-warm-red" style="font-size: 3rem;"></i>
            </div>

            <h2 class="text-warm-red mb-3">Провери новата си поща</h2>

            <p class="text-muted mb-4">Ако адресът е свободен, изпратихме линк за потвърждение на новия имейл. Имейлът на профила ще се смени, след като отвориш линка.</p>

            <div class="d-grid">
                <a asp-controller="Users" asp-action="Edit" class="btn" style="background-color: var(--buttery-yellow); color: white;">Обратно към профила</a>
            </div>
        </div>
    </div>
</div>
