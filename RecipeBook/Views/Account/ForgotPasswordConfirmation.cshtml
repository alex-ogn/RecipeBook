@{
    ViewData["Title"] = "Провери пощата си";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow" style="max-width: 500px; width: 100%;">
        <div class="card-body p-4 text-center">
            <div class="mb-3">
                <i class="bi bi-envelope-check text-warm-red" style="font-size: 3rem;"></i>
            </div>

            <h2 class="text-warm-red mb-3">Провери пощата си</h2>

            <p class="text-muted mb-4">Ако има профил с този имейл, изпратихме линк за смяна на паролата. Ако не виждаш имейла до няколко минути, провери папката <em>Spam / Спам</em>.</p>

            <div class="d-grid">
                <a asp-action="Login" class="btn" style="background-color: var(--buttery-yellow); color: white;">Към страницата за вход</a>
            </div>
        </div>
    </div>
</div>
