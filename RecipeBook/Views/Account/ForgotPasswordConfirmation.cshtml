@*
    Account/ForgotPasswordConfirmation.cshtml — MESSAGE: "we sent a reset link"
    The text does not say whether the account exists, on purpose (security).
    Rendered inside the centered card of _AuthLayout.cshtml.
*@
@{
    ViewData["Title"] = "Провери пощата си";
    Layout = "_AuthLayout";
}

<div class="auth__icon"><i class="bi bi-envelope-check"></i></div>
<h1 class="auth__title">Провери пощата си</h1>
<p class="auth__lead">Ако има профил с този имейл, изпратихме линк за смяна на паролата. Ако не виждаш имейла до няколко минути, провери папката <em>Spam / Спам</em>.</p>

<a asp-action="Login" class="btn btn-primary w-100">Към страницата за вход</a>
