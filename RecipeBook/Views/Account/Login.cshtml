@*
    Account/Login.cshtml — SIGN IN
    -------------------------------------------------------------------------
    Rendered inside the centered card of _AuthLayout.cshtml.
    Errors such as "wrong user name or password" appear in the validation
    summary at the top of the form; errors of a single field appear under it.
*@
@model RecipeBook.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Вход";
    Layout = "_AuthLayout";
}

<h1 class="auth__title">Вход в акаунта</h1>

<form asp-action="Login" method="post">
    <div asp-validation-summary="ModelOnly" class="form-errors"></div>

    @* Where to go after a successful login (the page that asked the user to sign in). *@
    <input type="hidden" name="returnUrl" value="@ViewData[ViewDataKeys.ReturnUrl]" />

    <div class="form-field">
        <label asp-for="Identifier" class="form-label"></label>
        <input asp-for="Identifier" class="form-control" autocomplete="username" />
        <span asp-validation-for="Identifier"></span>
    </div>

    <div class="form-field">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" type="password" autocomplete="current-password" />
        <span asp-validation-for="Password"></span>
    </div>

    <div class="form-check form-field">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label"></label>
    </div>

    @* w-100 = full width of the card. *@
    <button type="submit" class="btn btn-primary w-100">Вход</button>
</form>

<div class="auth__links">
    <a asp-action="ForgotPassword">Забравена парола?</a>
    <a asp-action="Register">Нямаш акаунт? Регистрирай се</a>
    <a asp-action="ResendConfirmation" class="text-muted small">Не получи имейл за потвърждение?</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
