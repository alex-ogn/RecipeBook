@{
    ViewData["Title"] = "Имейлът е сменен";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow" style="max-width: 500px; width: 100%;">
        <div class="card-body p-4 text-center">
            <div class="mb-3">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>
            </div>

            <h2 class="text-warm-red mb-3">Имейлът е сменен</h2>

            <p class="text-muted mb-4">Новият ти имейл адрес е потвърден и вече се използва за профила.</p>

            <div class="d-grid">
                <a asp-controller="Home" asp-action="Index" class="btn" style="background-color: var(--buttery-yellow); color: white;">Към началната страница</a>
            </div>
        </div>
    </div>
</div>
