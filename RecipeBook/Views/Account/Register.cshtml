@*
    Account/Register.cshtml — CREATE AN ACCOUNT
    -------------------------------------------------------------------------
    Rendered inside the centered card of _AuthLayout.cshtml.
    After a successful registration the user is sent to RegisterConfirmation.
*@
@model RecipeBook.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Регистрация";
    Layout = "_AuthLayout";
}

<h1 class="auth__title">Създай акаунт</h1>

<form asp-controller="Account" asp-action="Register" method="post">
    <div asp-validation-summary="ModelOnly" class="form-errors"></div>

    <input type="hidden" name="returnUrl" value="@ViewData[ViewDataKeys.ReturnUrl]" />

    <div class="form-field">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email"></span>
    </div>

    <div class="form-field">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" />
        <span asp-validation-for="Password"></span>
    </div>

    <div class="form-field">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">Регистрация</button>
</form>

<div class="auth__links">
    <a asp-action="Login">Вече имаш акаунт? Вход</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
