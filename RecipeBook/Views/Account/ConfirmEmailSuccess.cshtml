@{
    ViewData["Title"] = "Имейлът е потвърден";
}

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card shadow" style="max-width: 500px; width: 100%;">
        <div class="card-body p-4 text-center">

            <div class="mb-3">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>
            </div>

            <h2 class="text-warm-red mb-3">Успешно потвърждение!</h2>

            <p class="text-muted mb-4">
                Твоят имейл адрес беше потвърден успешно. Вече можеш да влезеш в профила си и да използваш всички функционалности.
            </p>

            <div class="d-grid">
                <a asp-action="Login" asp-controller="Account" class="btn" style="background-color: var(--buttery-yellow); color: white;">
                    Вход в акаунта
                </a>
            </div>

        </div>
    </div>
</div>