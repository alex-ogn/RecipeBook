@*
    Account/ConfirmEmailSuccess.cshtml — MESSAGE: "your e-mail is confirmed"
    Shown after the user opens the link from the registration e-mail.
    Rendered inside the centered card of _AuthLayout.cshtml.
*@
@{
    ViewData["Title"] = "Имейлът е потвърден";
    Layout = "_AuthLayout";
}

<div class="auth__icon auth__icon--success"><i class="bi bi-check-circle-fill"></i></div>
<h1 class="auth__title">Успешно потвърждение!</h1>
<p class="auth__lead">Твоят имейл адрес беше потвърден успешно. Вече можеш да влезеш в профила си и да използваш всички функционалности.</p>

<a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100">Вход в акаунта</a>
