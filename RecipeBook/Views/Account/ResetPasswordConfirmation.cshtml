@*
    Account/ResetPasswordConfirmation.cshtml — MESSAGE: "your password was changed"
    Rendered inside the centered card of _AuthLayout.cshtml.
*@
@{
    ViewData["Title"] = "Паролата е сменена";
    Layout = "_AuthLayout";
}

<div class="auth__icon auth__icon--success"><i class="bi bi-check-circle-fill"></i></div>
<h1 class="auth__title">Паролата е сменена</h1>
<p class="auth__lead">Вече можеш да влезеш с новата си парола.</p>

<a asp-action="Login" class="btn btn-primary w-100">Вход в акаунта</a>
