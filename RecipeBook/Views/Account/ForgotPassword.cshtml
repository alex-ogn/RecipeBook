@*
    Account/ForgotPassword.cshtml — ASK FOR A PASSWORD-RESET LINK
    -------------------------------------------------------------------------
    Rendered inside the centered card of _AuthLayout.cshtml.
*@
@model RecipeBook.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Забравена парола";
    Layout = "_AuthLayout";
}

<h1 class="auth__title">Забравена парола</h1>
<p class="auth__lead">Въведи имейла на профила си и ще ти изпратим линк за нова парола.</p>

<form asp-action="ForgotPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="form-errors"></div>

    <div class="form-field">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">Изпрати линк</button>
</form>

<div class="auth__links">
    <a asp-action="Login">Обратно към вход</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
