@*
    Account/ResetPassword.cshtml — CHOOSE A NEW PASSWORD
    -------------------------------------------------------------------------
    Opened from the link in the "forgotten password" e-mail. The hidden Token
    field carries the secret code from that link back to the server.
    Rendered inside the centered card of _AuthLayout.cshtml.
*@
@model RecipeBook.ViewModels.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "Нова парола";
    Layout = "_AuthLayout";
}

<h1 class="auth__title">Задай нова парола</h1>
<p class="auth__lead">Избери нова парола за профила си.</p>

<form asp-action="ResetPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="form-errors"></div>

    <input type="hidden" asp-for="Token" />

    <div class="form-field">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" />
        <span asp-validation-for="Email"></span>
    </div>

    <div class="form-field">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" />
        <span asp-validation-for="Password"></span>
    </div>

    <div class="form-field">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">Запази паролата</button>
</form>

<div class="auth__links">
    <a asp-action="Login">Обратно към вход</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
