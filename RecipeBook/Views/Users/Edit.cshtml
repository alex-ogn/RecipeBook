@*
    Users/Edit.cshtml — PROFILE SETTINGS
    -------------------------------------------------------------------------
    Opened by a user for their own profile, or by an admin for any user.

    Two columns on wide screens (one under the other on phones):
      left    "Профил" form: user name, e-mail (read-only), phone, new picture
              "Сигурност" panel — only on your OWN profile:
                  change password / change e-mail / delete account
              "Администрация" panel — only for an ADMIN looking at SOMEONE ELSE:
                  status, send password reset, lock / unlock, delete user
      right   the current profile picture

    The lock and delete forms use data-confirm: site.js asks before sending.
    The look (.settings) is in wwwroot/css/pages.css, section 6.
*@
@model RecipeBook.ViewModels.Users.EditUserViewModel

@{
    ViewData["Title"] = "Настройки на профила";

    // Is the person LOOKING at the page an admin? (Set by UsersController.Edit.)
    bool isUserAdmin = ViewData[ViewDataKeys.IsUserAdmin] as bool? ?? false;

    // ".jpg,.jpeg,.png,.webp" — the file dialog only offers the image types the server accepts.
    var acceptedImages = string.Join(",", ImageConstants.AllowedImageExtensions);
}

<div class="page-header">
    <h1>Настройки на профила</h1>
</div>

<partial name="_Alerts" />

<div class="settings">

    <div class="settings__main">

        @* ---------- Profile form ----------
           enctype="multipart/form-data" is required for the picture upload. *@
        <section class="panel">
            <h2 class="panel__title">Профил</h2>

            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />

                <div class="form-field">
                    <label asp-for="UserName" class="form-label"></label>
                    <input asp-for="UserName" class="form-control" />
                    <span asp-validation-for="UserName"></span>
                </div>

                @* The e-mail is shown but cannot be edited here (it has no "name", so it is
                   not sent with the form). It is changed through Account/ChangeEmail. *@
                <div class="form-field">
                    <label asp-for="Email" class="form-label"></label>
                    <div class="settings__email">
                        <input value="@Model.Email" class="form-control" readonly aria-label="Имейл" />
                        @if (Model.EmailConfirmed)
                        {
                            <span class="chip chip--green">Потвърден</span>
                        }
                        else
                        {
                            <span class="chip chip--orange">Непотвърден</span>
                        }
                    </div>
                </div>

                <div class="form-field">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber"></span>
                </div>

                <div class="form-field">
                    <label asp-for="ProfilePicture" class="form-label"></label>
                    <input asp-for="ProfilePicture" type="file" class="form-control" accept="@acceptedImages" />
                </div>

                <div class="button-row">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg"></i> Запази
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Назад
                    </a>
                </div>
            </form>
        </section>

        @* ---------- Security (own profile only) ---------- *@
        @if (Model.IsOwnProfile)
        {
            <section class="panel">
                <h2 class="panel__title"><i class="bi bi-shield-lock"></i> Сигурност</h2>

                <div class="button-row">
                    <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-key"></i> Смени паролата
                    </a>
                    <a asp-controller="Account" asp-action="ChangeEmail" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-envelope"></i> Смени имейла
                    </a>
                    @* An admin cannot delete their own account. *@
                    @if (!isUserAdmin)
                    {
                        <a asp-controller="Account" asp-action="DeleteAccount" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i> Изтрий профила си
                        </a>
                    }
                </div>
            </section>
        }

        @* ---------- Administration (admin looking at another user) ---------- *@
        @if (isUserAdmin && !Model.IsOwnProfile)
        {
            <section class="panel">
                <h2 class="panel__title"><i class="bi bi-person-gear"></i> Администрация</h2>

                <p>
                    Статус:
                    @if (Model.IsDisabled)
                    {
                        <span class="chip chip--red">Деактивиран</span>
                    }
                    else if (Model.IsLockedOut)
                    {
                        <span class="chip chip--orange">Временно заключен до @Model.LockoutEnd?.ToLocalTime().ToString("g")</span>
                    }
                    else
                    {
                        <span class="chip chip--green">Активен</span>
                    }
                </p>

                @* Each button is its own small POST form (the action changes data). *@
                <div class="button-row">
                    <form asp-action="SendPasswordReset" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-envelope-arrow-up"></i> Изпрати линк за нова парола
                        </button>
                    </form>

                    @if (Model.IsLockedOut)
                    {
                        <form asp-action="Unlock" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-unlock"></i> Активирай
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Lock" asp-route-id="@Model.Id" method="post" data-confirm="Деактивиране на този потребител?">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                <i class="bi bi-lock"></i> Деактивирай
                            </button>
                        </form>
                    }

                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm="Сигурни ли сте, че искате да изтриете този потребител?">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i> Изтрий потребител
                        </button>
                    </form>
                </div>
            </section>
        }
    </div>

    @* ---------- Current picture ---------- *@
    <aside class="settings__aside panel">
        <img src="@Url.Action("GetProfilePicture", "Users", new { userId = Model.Id, pictureVersion = Model.ProfilePictureVersion })"
             alt="Текуща профилна снимка" class="avatar avatar--xl" />
        <div class="fw-bold mt-3">@Model.UserName</div>
        <a asp-controller="Recipes" asp-action="MyIndex" asp-route-id="@Model.Id" class="small">Виж профила</a>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
