@model RecipeBook.ViewModels.Users.EditUserViewModel

@{
    ViewData["Title"] = "Редакция на потребител";

    bool isUserAdmin = ViewData[ViewDataKeys.IsUserAdmin] as bool? ?? false;
}

<div class="container mt-4">
    <h1 class="mb-4">Редактирай профил</h1>

    @if (TempData[TempDataKeys.ErrorMessage] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData[TempDataKeys.ErrorMessage]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData[TempDataKeys.SuccessMessage] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData[TempDataKeys.SuccessMessage]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="UserName" class="form-label"></label>
                    <input asp-for="UserName" class="form-control" />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <div class="d-flex align-items-center gap-2">
                        <input value="@Model.Email" class="form-control" readonly />
                        @if (Model.EmailConfirmed)
                        {
                            <span class="badge bg-success">Потвърден</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Непотвърден</span>
                        }
                    </div>
                    @if (Model.IsOwnProfile)
                    {
                        <a asp-controller="Account" asp-action="ChangeEmail" class="small">Смени имейла</a>
                    }
                </div>

                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ProfilePicture" class="form-label"></label>
                    <input asp-for="ProfilePicture" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i> Запази
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Назад
                    </a>
                </div>
            </form>

            @if (Model.IsOwnProfile)
            {
                <div class="card mt-4">
                    <div class="card-header"><i class="bi bi-shield-lock me-1"></i> Сигурност</div>
                    <div class="card-body d-flex flex-wrap gap-2">
                        <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-key"></i> Смени паролата
                        </a>
                        <a asp-controller="Account" asp-action="ChangeEmail" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-envelope"></i> Смени имейла
                        </a>
                        @if (!isUserAdmin)
                        {
                            <a asp-controller="Account" asp-action="DeleteAccount" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash"></i> Изтрий профила си
                            </a>
                        }
                    </div>
                </div>
            }

            @if (isUserAdmin && !Model.IsOwnProfile)
            {
                <div class="card mt-4">
                    <div class="card-header"><i class="bi bi-person-gear me-1"></i> Администрация</div>
                    <div class="card-body">
                        <p class="mb-3">
                            Статус:
                            @if (Model.IsDisabled)
                            {
                                <span class="badge bg-danger">Деактивиран</span>
                            }
                            else if (Model.IsLockedOut)
                            {
                                <span class="badge bg-warning text-dark">Временно заключен до @Model.LockoutEnd?.ToLocalTime().ToString("g")</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Активен</span>
                            }
                        </p>

                        <div class="d-flex flex-wrap gap-2">
                            <form asp-action="SendPasswordReset" asp-route-id="@Model.Id" method="post">
                                <button type="submit" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-envelope-arrow-up"></i> Изпрати линк за нова парола
                                </button>
                            </form>

                            @if (Model.IsLockedOut)
                            {
                                <form asp-action="Unlock" asp-route-id="@Model.Id" method="post">
                                    <button type="submit" class="btn btn-outline-success btn-sm">
                                        <i class="bi bi-unlock"></i> Активирай
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Lock" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Деактивиране на този потребител?');">
                                    <button type="submit" class="btn btn-outline-warning btn-sm">
                                        <i class="bi bi-lock"></i> Деактивирай
                                    </button>
                                </form>
                            }

                            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Сигурни ли сте, че искате да изтриете този потребител?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash"></i> Изтрий потребител
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }

        </div>

        <div class="col-md-4 offset-md-1">
            <label class="form-label">Текуща профилна снимка:</label>
            <img src="@Url.Action("GetProfilePicture", "Users", new { userId = Model.Id, pictureVersion = Model.ProfilePictureVersion })"
                 class="img-thumbnail mt-2"
                 style="width: 200px; height: 200px; object-fit: cover;" />
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
