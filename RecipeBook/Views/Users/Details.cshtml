@*
    Users/Details.cshtml — ONE USER'S DATA (admins only)
    -------------------------------------------------------------------------
    A read-only card: picture, user name, e-mail, phone.
*@
@model RecipeBook.ViewModels.Users.EditUserViewModel

@{
    ViewData["Title"] = "Потребител";
}

<section class="panel panel--narrow">
    <h1 class="panel__title">Преглед на потребител</h1>

    <img src="@Model.ExistingProfilePictureUrl"
         alt="Профилна снимка" class="avatar avatar--xl mb-4" />

    <dl class="detail-list">
        <dt>Потребителско име</dt>
        <dd>@Model.UserName</dd>

        <dt>Имейл</dt>
        <dd>@Model.Email</dd>

        <dt>Телефон</dt>
        <dd>@Model.PhoneNumber</dd>
    </dl>

    <div class="button-row">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Редактирай
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
    </div>
</section>
