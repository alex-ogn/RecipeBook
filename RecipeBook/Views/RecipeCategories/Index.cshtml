@*
    RecipeCategories/Index.cshtml — ADMIN: LIST OF RECIPE CATEGORIES
    Page header with the "add" button, messages and the table
    (same structure as Ingredients/Index.cshtml, without filter and pager).
*@
@model IEnumerable<RecipeBook.Models.RecipeCategory>

@{
    ViewData["Title"] = "Категории на рецепти";
}

<div class="page-header">
    <h1>Категории на рецепти</h1>
    <a asp-action="Create" class="btn btn-accent">
        <i class="bi bi-plus-lg"></i> Нова категория
    </a>
</div>

<partial name="_Alerts" />

<div class="table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th>Име</th>
                <th class="data-table__actions">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td class="data-table__actions">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-icon" title="Редактирай">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-icon" title="Детайли">
                            <i class="bi bi-info-circle"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-icon btn-icon--danger" title="Изтрий">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
