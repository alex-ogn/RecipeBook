@*
    RecipeCategories/Details.cshtml — ADMIN: ONE RECIPE CATEGORY (read-only)
*@
@model RecipeBook.Models.RecipeCategory

@{
    ViewData["Title"] = "Детайли за категория";
}

<section class="panel panel--narrow">
    <h1 class="panel__title">Детайли за категория на рецепта</h1>

    <dl class="detail-list">
        <dt>Име на категория</dt>
        <dd>@Model.Name</dd>
    </dl>

    <div class="button-row">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Редактирай
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Назад към списъка
        </a>
    </div>
</section>
