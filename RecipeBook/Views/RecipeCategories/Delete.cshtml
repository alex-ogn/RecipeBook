@*
    RecipeCategories/Delete.cshtml — ADMIN: CONFIRM DELETING A RECIPE CATEGORY
    Nothing is deleted until the red button posts the form.
*@
@model RecipeBook.Models.RecipeCategory

@{
    ViewData["Title"] = "Изтриване на категория";
}

<section class="panel panel--narrow panel--danger">
    <h1 class="panel__title">Изтрий категория</h1>

    <p>Сигурни ли сте, че искате да изтриете следната категория?</p>

    <dl class="detail-list">
        <dt>Име</dt>
        <dd>@Model.Name</dd>
    </dl>

    <form asp-action="Delete" method="post" class="button-row">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash"></i> Изтрий
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
    </form>
</section>
