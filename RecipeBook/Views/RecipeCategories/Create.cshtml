@*
    RecipeCategories/Create.cshtml — ADMIN: ADD A RECIPE CATEGORY
*@
@model RecipeBook.Models.RecipeCategory

@{
    ViewData["Title"] = "Добавяне на категория";
}

<section class="panel panel--narrow">
    <h1 class="panel__title">Добави нова категория</h1>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="form-errors"></div>

        <div class="form-field">
            <label asp-for="Name" class="form-label">Име</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name"></span>
        </div>

        <div class="button-row">
            <button type="submit" class="btn btn-primary">Добави</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
