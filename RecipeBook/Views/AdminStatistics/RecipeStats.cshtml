@*
    AdminStatistics/RecipeStats.cshtml — ADMIN: RECIPE STATISTICS
    -------------------------------------------------------------------------
    Top row:    two ranked lists (most commented, most saved recipes)
    Bottom row: two charts (recipes per category, recipes per hour of day)

    The charts are drawn by wwwroot/js/admin-charts.js with the Chart.js
    library. This page only provides:
      - an empty <canvas> for each chart (the script finds it by its id)
      - the numbers, as JSON, in the <script id="stats-data"> block
    Clicking a slice of the category chart opens the recipe list filtered by
    that category (the address comes from data-recipes-url).

    The look (.stats-grid, .chart-box, .rank-list) is in pages.css, section 7.
*@
@using RecipeBook.ViewModels.AdminStatistics;
@model RecipeAnalyticsViewModel
@{
    ViewData["Title"] = "Статистика за рецепти";
}

<div class="page-header">
    <h1>Статистика за рецепти</h1>
</div>

<div class="stats-grid">
    <section class="panel">
        <h2 class="panel__title">Най-коментирани рецепти</h2>
        <ol class="rank-list">
            @foreach (var r in Model.MostCommentedRecipes)
            {
                <li>
                    <a asp-controller="Recipes" asp-action="Details" asp-route-id="@r.Id">@r.Title</a>
                    <span class="chip chip--green"><i class="bi bi-chat"></i> @r.Count</span>
                </li>
            }
        </ol>
    </section>

    <section class="panel">
        <h2 class="panel__title">Най-запазвани рецепти</h2>
        <ol class="rank-list">
            @foreach (var r in Model.MostSavedRecipes)
            {
                <li>
                    <a asp-controller="Recipes" asp-action="Details" asp-route-id="@r.Id">@r.Title</a>
                    <span class="chip chip--orange"><i class="bi bi-bookmark"></i> @r.Count</span>
                </li>
            }
        </ol>
    </section>

    <section class="panel">
        <h2 class="panel__title">Разпределение по категории</h2>
        <div class="chart-box">
            <canvas id="categoryChart" data-recipes-url="@Url.Action("Index", "Recipes")"></canvas>
        </div>
    </section>

    <section class="panel">
        <h2 class="panel__title">Активност по часове</h2>
        <div class="chart-box">
            <canvas id="hourChart"></canvas>
        </div>
    </section>
</div>

@* The numbers for the charts. type="application/json" = the browser does not run this, the script reads it. *@
<script type="application/json" id="stats-data">
    @Html.Raw(Json.Serialize(new
    {
        categoryLabels = Model.CategoryDistribution.Keys,
        categoryValues = Model.CategoryDistribution.Values,
        categoryIds = Model.CategoryNameToIdMap,
        hourLabels = Model.HourDistribution.Keys,
        hourValues = Model.HourDistribution.Values
    }))
</script>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/admin-charts.js" asp-append-version="true"></script>
}
