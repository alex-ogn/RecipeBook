@*
    AdminStatistics/UserStats.cshtml — ADMIN: USER STATISTICS
    -------------------------------------------------------------------------
    Two bar charts (recipes per user, likes received per user) and the list
    of users without any activity.

    The charts are drawn by wwwroot/js/admin-charts.js with the Chart.js
    library. This page only provides an empty <canvas> for each chart and the
    numbers, as JSON, in the <script id="stats-data"> block.

    The look (.stats-grid, .chart-box) is in pages.css, section 7.
*@
@using RecipeBook.ViewModels.AdminStatistics;
@model AdminUserStatsViewModel
@{
    ViewData["Title"] = "Статистика за потребители";
}

<div class="page-header">
    <h1>Статистика за потребители</h1>
</div>

<div class="stats-grid">
    <section class="panel">
        <h2 class="panel__title">Брой рецепти</h2>
        <div class="chart-box">
            <canvas id="recipesChart"></canvas>
        </div>
    </section>

    <section class="panel">
        <h2 class="panel__title">Харесвания на рецепти</h2>
        <div class="chart-box">
            <canvas id="likesChart"></canvas>
        </div>
    </section>
</div>

<section class="panel">
    <h2 class="panel__title">Потребители без активност</h2>

    @if (Model.InactiveUsers.Any())
    {
        <div class="chip-list">
            @foreach (var u in Model.InactiveUsers)
            {
                <span class="chip">@u.UserName</span>
            }
        </div>
    }
    else
    {
        <p class="text-muted mb-0">Всички потребители са активни.</p>
    }
</section>

@* The numbers for the charts. type="application/json" = the browser does not run this, the script reads it. *@
<script type="application/json" id="stats-data">
    @Html.Raw(Json.Serialize(new
    {
        userNames = Model.AllUsers.Select(u => u.UserName),
        recipeCounts = Model.AllUsers.Select(u => u.RecipeCount),
        likesReceived = Model.AllUsers.Select(u => u.LikesReceived)
    }))
</script>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/admin-charts.js" asp-append-version="true"></script>
}
